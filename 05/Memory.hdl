 // File name: projects/05/Memory.hdl

 /**
  * The complete address space of the Hack computer's memory,
  * including RAM and memory-mapped I/O.
  */

 CHIP Memory {
     IN in[16], load, address[15];
     OUT out[16];

     PARTS:
     // Select RAM16K or Screen/Keyboard
     Not(in=address[14], out=ramSelect);
     And(a=load, b=ramSelect, out=ramLoad);

     // Screen selection
     Not(in=address[13], out=notScreenBit);
     And(a=address[14], b=notScreenBit, out=screenSelect);
     And(a=load, b=screenSelect, out=screenLoad);

     // Main RAM
     RAM16K(
         in=in,
         load=ramLoad,
         address=address[0..13],
         out=ramOut
     );

     // Screen memory
     Screen(
         in=in,
         load=screenLoad,
         address=address[0..12],
         out=screenOut
     );

     // Keyboard input
     Keyboard(out=keyboardOut);

     // Select Screen or Keyboard
     Mux16(
         a=screenOut,
         b=keyboardOut,
         sel=address[13],
         out=ioOut
     );

     // Select RAM or I/O
     Mux16(
         a=ramOut,
         b=ioOut,
         sel=address[14],
         out=out
     );
 }
